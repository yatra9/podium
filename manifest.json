{
  "manifest_version": 3,
  "name": "Podium (personal pCloud build)",
  "version": "0.1.0",
  "description": "Podium sheet-music studio with pCloud OAuth support.",
  "key": "",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://my.pcloud.com/*",
    "https://api.pcloud.com/*",
    "https://eapi.pcloud.com/*",
    "https://*.pcloud.com/*"
  ],
  "background": {
    "service_worker": "extension-background.js"
  },
  "action": {
    "default_title": "Launch Podium"
  }
}
