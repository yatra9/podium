# Shell scripts must keep LF endings whatever core.autocrlf says: a CR at the
# end of a shebang or a command makes bash fail in ways that read as the script
# being wrong rather than the checkout.
*.sh text eol=lf

# WebAssembly and MediaPipe task bundles are binary whatever git's content
# sniffing makes of them: a line-ending rewrite inside one is silent and fatal.
*.wasm binary
*.task binary
