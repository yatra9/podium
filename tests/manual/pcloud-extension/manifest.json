{
  "manifest_version": 3,
  "name": "Podium pCloud capability probe",
  "version": "0.1.0",
  "description": "Manual probe for pCloud OAuth and private PDF downloads from a Chrome extension.",
  "key": "",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://my.pcloud.com/*",
    "https://api.pcloud.com/*",
    "https://eapi.pcloud.com/*",
    "https://*.pcloud.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open pCloud capability probe"
  }
}
